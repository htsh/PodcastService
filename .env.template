# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# MLX Whisper Model Path
WHISPER_MODEL_PATH=/path/to/mlx/whisper/model

# Optional: LLM Settings
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=32000
LLM_TEMPERATURE=0.8

# MongoDB Settings
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=podcast_service

# Speaker Diarization Settings
# Enable/disable speaker diarization (true/false)
ENABLE_DIARIZATION=true

# HuggingFace token for pyannote models
# Get your token from https://huggingface.co/settings/tokens
# Accept model terms at https://huggingface.co/pyannote/speaker-diarization-3.1
HUGGINGFACE_TOKEN=your_huggingface_token_here

# Optional: Speaker count constraints (leave empty for automatic detection)
# MIN_SPEAKERS=2
# MAX_SPEAKERS=5 
